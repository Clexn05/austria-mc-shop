{
  "name": "austria-mc-shop",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ./wrangler.jsonc",
    "deploy": "wrangler deploy --config ./wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "db:fresh": "wrangler d1 execute austria-mc-shop --remote --file=./schema.sql",
    "db:admin": "wrangler d1 execute austria-mc-shop --remote --file=./migrate-admin.sql",
    "db:payments": "wrangler d1 execute austria-mc-shop --remote --file=./migrate-direct-payments.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260923.1",
    "typescript": "5.9.3",
    "wrangler": "4.137.0"
  }
}
