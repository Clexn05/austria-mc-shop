{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "austria-mc-shop",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "routes": [
    {
      "pattern": "buy.austria-mc.net/*",
      "zone_name": "austria-mc.net"
    }
  ],

  "vars": {
    "STORE_BASE_URL": "https://buy.austria-mc.net",
    "PAYPAL_ENV": "sandbox",
    "KLARNA_ENV": "playground",
    "PAYSAFECARD_ENV": "test"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "austria-mc-shop",
      "database_id": "65135b75-3b98-4f11-9175-3c27dd4ef543"
    }
  ]
}
